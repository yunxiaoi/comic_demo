<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.comic.mapper.UserFavoriteMapper">

    <resultMap id="userFavoriteWithComic" type="com.comic.entity.UserFavorite">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="comicId" column="comic_id"/>
        <result property="createTime" column="create_time"/>
        <association property="comic" javaType="com.comic.entity.Comic">
            <id property="id" column="comic_id"/>
            <result property="title" column="title"/>
            <result property="cover" column="cover"/>
            <result property="author" column="author"/>
            <result property="status" column="status"/>
            <result property="isPaid" column="is_paid"/>
            <result property="price" column="price"/>
        </association>
    </resultMap>

    <select id="findByUserId" resultMap="userFavoriteWithComic">
        SELECT f.*, c.title, c.cover, c.author, c.status, c.is_paid, c.price
        FROM user_favorite f
                 LEFT JOIN comic c ON f.comic_id = c.id
        WHERE f.user_id = #{userId}
        ORDER BY f.id DESC
    </select>

</mapper>